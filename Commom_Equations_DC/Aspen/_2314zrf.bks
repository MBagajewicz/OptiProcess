 ? SETUP UNITS-SET SET1 ? \ UNITSET BASESET = MET (3 3 3 3 3 1 12 3 3 3 3 3 22  
 3 7 9 3 3 3 19 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 10 9 11 5 3 3 3 3 3 3 6 4 3 
 3 9 3 3 3 3 4 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 17 3 3 3 5 9 3 3 3 3 3 3 9 5 3 3 
 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3  
 3 3 3 3 3 3 3 3 7 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3 3) \                         
 ? %M FLOWSHEET GLOBAL ? ; SET1 ; \ BLOCK BLKID = HPC IN = (FEED X) OUT =       
 (D-TOP X B-BOTTOM X) \ \ BLOCK BLKID = LPC IN = (FEED-LPC X) OUT = (L-TOP X    
 L-BOTTOM X) \ \ BLOCK BLKID = B1 IN = (FEED-B1 X) OUT = (B1-TOP X B2-BOT X) \  
 ? BLOCK RADFRAC HPC ? ; SET1 ; \ REPORT HYDRAULIC = NOHYDRAULIC \ \ PARAM      
 NSTAGE = 21 MAXOL = 110 ALGORITHM = NEWTON DAMPING = NONE HYDRAUL = NO \ \     
 COL-SPECS RR-BASIS = MOLE BASIS-RR = 1.30 <-1> <0> D-BASIS = MOLE BASIS-D =    
 59.80 <-89> <3> \ \ FEEDS FEED-SID = FEED FEED-STAGE = 18 \ \ P-SPEC           
 PRES-STAGE = 1 STAGE-PRES = 100000.0 <20> <19> \ \ PRODUCTS PROD-STREAM =      
 D-TOP PROD-STAGE = 1 PROD-PHASE = L / PROD-STREAM = B-BOTTOM PROD-STAGE = 21   
 PROD-PHASE = L \ \ CONVERGENCE EXTRA-ML = 2 \ \ COL-CONFIG CONDENSER = TOTAL   
 CA-CONFIG = INT-1 \ \ PARAM2 STATIC-DP = YES OLD-SULZER = NO \ \ SPEC SPEC-NO  
 = 1 SPEC-TYPE = Q1 VALUE = -5.54881E+06 <0> <0> SPEC-ACTIVE = YES SPEC-DESCRIP 
 = "CONDENSER DUTY" / SPEC-NO = 2 SPEC-TYPE = MOLE-FRAC VALUE = .0050 <0> <0>   
 SPEC-COMPS = (METHANOL) SPEC-STREAMS = (B-BOTTOM) SPEC-DESCRIP =               
 "BOTTOM PURITY" \ \ VARY VARY-NO = 1 VARTYPE = D LB = 0.0 <0> <0> UB =         
 100.0 <0> <0> / VARY-NO = 2 VARTYPE = RR LB = 0.0 <0> <0> UB = 100.0 <0> <0> \ 
 "\@"                                                                           
