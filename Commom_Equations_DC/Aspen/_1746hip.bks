 COL-SPECS RR-BASIS = MOLE BASIS-RR = 1.30 <-1> <0> D-BASIS = MOLE BASIS-D =    
 59.80 <-89> <3> \ \ FEEDS FEED-SID = FEED FEED-STAGE = 6 \ \ P-SPEC PRES-STAGE 
 = 1 STAGE-PRES = 100000.0 <20> <19> \ \ PRODUCTS PROD-STREAM = D-TOP           
 PROD-STAGE = 1 PROD-PHASE = L / PROD-STREAM = B-BOTTOM PROD-STAGE = 13         
