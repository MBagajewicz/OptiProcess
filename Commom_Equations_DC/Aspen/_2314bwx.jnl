MARSHAL
SUMHEAD
SHOW SEQUENCE
GO ALL
SCOPE
STATUS
QUERY   STREAMS  ALL
QUERY   BLOCK    HPC
QUERY   BLOCK    HPC
ZCNRESET
EDIT INPUT
##1
FLOWSHEET ;##1
    BLOCK HPC IN=FEED-HPC OUT=H-TOP H-BOTTOM
    BLOCK LPC IN=FEED-LPC OUT=L-TOP L-BOTTOM
    BLOCK B1 IN=FEED OUT=D-TOP B-BOTTOM
BLOCK HPC RADFRAC ;##1
    PARAM NSTAGE=24 ALGORITHM=NEWTON HYDRAULIC=NO MAXOL=110  &
        DAMPING=NONE
    PARAM2 STATIC-DP=YES OLD-SULZER=NO
    COL-CONFIG CONDENSER=TOTAL CA-CONFIG=INT-1
    FEEDS FEED-HPC 18
    PRODUCTS H-TOP 1 L / H-BOTTOM 24 L
    P-SPEC 1 100000.
    COL-SPECS MOLE-D=59.8 MOLE-RR=1.3
    SPEC 1 Q1 -4548807. SPEC-ACTIVE=YES  &
        SPEC-DESCRIP="Condenser Duty"
    SPEC 2 MOLE-FRAC 0.005 COMPS=METHANOL STREAMS=H-BOTTOM  &
        SPEC-DESCRIP="Bottom Purity"
    VARY 1 MOLE-D 0. 100.
    VARY 2 MOLE-RR 0. 100.
    REPORT NOHYDRAULIC
    CONVERGENCE EXTRA-ML=2
##2
QUERY   STREAMS  ALL
SHOW SEQUENCE
GO ALL
