        26    1        DC-WTOP-SIDE=123.4365231 <MM> DC-WBOT-SIDE=123.4365231 <MM>  &                                                                                                                                                                                          
        27    1        HOLE-DIAM=12.70000000 <MM> HOLE-AREA=.1000000000  &                                                                                                                                                                                                     
        28    1        FLOOD-METH=GLITSCH6 DECK-THICK=0.134 <IN>  &                                                                                                                                                                                                            
        29    1        PCT-FLOOD-FA=80.00000000 AER-PARAM-M=1.000000000  &                                                                                                                                                                                                     
        30    1        MAX-DC-LOAD=GLITSCH MAX-ACC-DP=2500.000000  &                                                                                                                                                                                                           
        31    1        MAX-PCT-DCB=100.0000000 MAX-PCT-ENT=10.00000000  &                                                                                                                                                                                                      
        32    1        MIN-WEIR-LD=4.470981863 MAX-WEIR-LD=117.3721131  &                                                                                                                                                                                                      
        33    1        MIN-PCT-DCA=.1000000000                                                                                                                                                                                                                                 
