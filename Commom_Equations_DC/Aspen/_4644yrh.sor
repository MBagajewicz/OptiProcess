         5    1BLOCK HPC RADFRAC                                                                                                                                                                                                                                               
         6    1    SUBOBJECTS INTERNALS = CS-1                                                                                                                                                                                                                                 
         7    1    PARAM NSTAGE=20 ALGORITHM=STANDARD HYDRAULIC=NO MAXOL=30  &                                                                                                                                                                                                 
         8    1        DAMPING=NONE                                                                                                                                                                                                                                            
