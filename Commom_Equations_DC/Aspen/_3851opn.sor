         1    1BLOCK HPC RADFRAC                                                                                                                                                                                                                                               
         2    1    PARAM NSTAGE=24 ALGORITHM=NEWTON HYDRAULIC=NO MAXOL=110  &                                                                                                                                                                                                  
         3    1        DAMPING=NONE                                                                                                                                                                                                                                            
         4    1    PARAM2 STATIC-DP=YES OLD-SULZER=NO                                                                                                                                                                                                                          
         5    1    COL-CONFIG CONDENSER=TOTAL CA-CONFIG=INT-1                                                                                                                                                                                                                  
         6    1    FEEDS FEED 20                                                                                                                                                                                                                                               
         7    1    PRODUCTS D-TOP 1 L / B-BOTTOM 24 L                                                                                                                                                                                                                          
         8    1    P-SPEC 1 100000.                                                                                                                                                                                                                                            
         9    1    COL-SPECS MOLE-D=59.8 MOLE-RR=1.3                                                                                                                                                                                                                           
        10    1    SPEC 1 Q1 -4591099.11 SPEC-ACTIVE=YES  &                                                                                                                                                                                                                    
        11    1        SPEC-DESCRIP="CONDENSER DUTY"                                                                                                                                                                                                                           
        12    1    SPEC 2 MOLE-FRAC 0.005 COMPS=METHANOL STREAMS=B-BOTTOM  &                                                                                                                                                                                                   
        13    1        SPEC-DESCRIP="BOTTOM PURITY"                                                                                                                                                                                                                            
        14    1    VARY 1 MOLE-D 0. 100.                                                                                                                                                                                                                                       
        15    1    VARY 2 MOLE-RR 0. 100.                                                                                                                                                                                                                                      
        16    1    REPORT NOHYDRAULIC                                                                                                                                                                                                                                          
        17    1    CONVERGENCE EXTRA-ML=2                                                                                                                                                                                                                                      
