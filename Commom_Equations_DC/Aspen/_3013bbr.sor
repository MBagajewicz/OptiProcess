         8    1    P-SPEC 1 500000.                                                                                                                                                                                                                                            
         9    1    COL-SPECS D:F=0.6 MOLE-RR=1.3                                                                                                                                                                                                                               
        10    1    SPEC 1 Q1 -82280148.4 SPEC-ACTIVE=YES  &                                                                                                                                                                                                                    
        11    1        SPEC-DESCRIP="CONDENSER DUTY"                                                                                                                                                                                                                           
