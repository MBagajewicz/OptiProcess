BLOCK HPC RADFRAC
    PARAM NSTAGE=19 ALGORITHM=NEWTON HYDRAULIC=NO MAXOL=110  &
        DAMPING=NONE
    PARAM2 STATIC-DP=YES OLD-SULZER=NO
    COL-CONFIG CONDENSER=TOTAL CA-CONFIG=INT-1
    FEEDS FEED-HPC 5
    PRODUCTS H-TOP 1 L / H-BOTTOM 19 L
    P-SPEC 1 500000.
    COL-SPECS D:F=0.6 MOLE-RR=1.3
    SPEC 1 Q1 -4635067.99 SPEC-ACTIVE=YES  &
        SPEC-DESCRIP="Condenser Duty"
    SPEC 2 MOLE-FRAC 0.005 COMPS=METHANOL STREAMS=H-BOTTOM  &
        SPEC-DESCRIP="Bottom Purity"
    VARY 1 D:F 0.01 1.
    VARY 2 MOLE-RR 0. 100.
    REPORT NOHYDRAULIC
    CONVERGENCE EXTRA-ML=2
