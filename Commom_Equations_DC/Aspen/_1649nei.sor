         1    1FLOWSHEET                                                                                                                                                                                                                                                       
         2    1    BLOCK HPC IN=FEED-HPC OUT=H-TOP H-BOTTOM                                                                                                                                                                                                                    
         3    1    BLOCK LPC IN=FEED-LPC OUT=L-TOP L-BOTTOM                                                                                                                                                                                                                    
         4    1    BLOCK B1 IN=FEED OUT=D-TOP B-BOTTOM                                                                                                                                                                                                                         
         5    1BLOCK HPC RADFRAC                                                                                                                                                                                                                                               
         6    1    PARAM NSTAGE=20 ALGORITHM=NEWTON HYDRAULIC=NO MAXOL=110  &                                                                                                                                                                                                  
         7    1        DAMPING=NONE                                                                                                                                                                                                                                            
         8    1    PARAM2 STATIC-DP=YES OLD-SULZER=NO                                                                                                                                                                                                                          
         9    1    COL-CONFIG CONDENSER=TOTAL CA-CONFIG=INT-1                                                                                                                                                                                                                  
        10    1    FEEDS FEED-HPC 13                                                                                                                                                                                                                                           
        11    1    PRODUCTS H-TOP 1 L / H-BOTTOM 20 L                                                                                                                                                                                                                          
        12    1    P-SPEC 1 500000.                                                                                                                                                                                                                                            
        13    1    COL-SPECS MOLE-D=59.8 MOLE-RR=1.3                                                                                                                                                                                                                           
        14    1    SPEC 1 Q1 -7098859.86 SPEC-ACTIVE=YES  &                                                                                                                                                                                                                    
        15    1        SPEC-DESCRIP="CONDENSER DUTY"                                                                                                                                                                                                                           
        16    1    SPEC 2 MOLE-FRAC 0.005 COMPS=METHANOL STREAMS=H-BOTTOM  &                                                                                                                                                                                                   
        17    1        SPEC-DESCRIP="BOTTOM PURITY"                                                                                                                                                                                                                            
        18    1    VARY 1 MOLE-D 0. 100.                                                                                                                                                                                                                                       
        19    1    VARY 2 MOLE-RR 0. 100.                                                                                                                                                                                                                                      
        20    1    REPORT NOHYDRAULIC                                                                                                                                                                                                                                          
        21    1    CONVERGENCE EXTRA-ML=2                                                                                                                                                                                                                                      
